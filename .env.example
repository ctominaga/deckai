DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DECKAI_ENABLE_REAL_DEEPSEEK=false

# Banco PostgreSQL de produção/homologação. Sem esta variável, o desenvolvimento
# usa PGlite persistente em private-data/deckai-pg.
DATABASE_URL=
PORT=8788
WEB_ORIGIN=http://localhost:5173
ALLOW_BOOTSTRAP=false

# PDF: descoberta automática de Chrome/Chromium/Edge, incluindo EdgeCore no Windows.
# Defina um caminho absoluto apenas para escolher outro executável.
# PDF_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
